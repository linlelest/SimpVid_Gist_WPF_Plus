<Window x:Class="SimpVid_Gist_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpVid_Gist_WPF"
        mc:Ignorable="d" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Title="SimpVid Gist"
        Height="700" Width="1200" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel MouseDown="DockPanel_MouseDown" Background="Transparent" Grid.Row="0">
            <TextBlock Margin="16,0,0,0" FontSize="24" TextWrapping="Wrap" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center">SimpVid Gist</TextBlock>
            <TextBlock Margin="4,0,0,0" FontSize="16" TextWrapping="Wrap" DockPanel.Dock="Left" VerticalAlignment="Bottom">Plus</TextBlock>
            <TextBlock x:Name="DescriptionText" Margin="10,0,0,0" TextWrapping="Wrap" DockPanel.Dock="Left" VerticalAlignment="Center">
                        Extract and summarize YouTube video transcripts.
                        Provide an AI API key to also generate a summary.
            </TextBlock>


            <Button x:Name="LangToggleButton" Content="中"
                    Margin="0,0,10,0" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Height="30"
                    Click="LangToggleButton_Click" Cursor="Hand"
                    Background="#999999" Width="40">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Width="40" CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="LayoutToggleButton"
                    Margin="0,0,10,0" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Height="30" Width="40"
                    Click="LayoutToggleButton_Click" Cursor="Hand"
                    Background="#6B7280" ToolTip="Switch layout mode">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Width="40" CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,4 H10 V20 H3 Z" Fill="Transparent" Stroke="White" StrokeThickness="1.5"/>
                        <Path Data="M6.5,4 V20" Stroke="White" StrokeThickness="1.2"/>
                        <Path Data="M14,4 H21 V20 H14 Z" Fill="Transparent" Stroke="White" StrokeThickness="1.5"/>
                        <Path Data="M14,12 H21" Stroke="White" StrokeThickness="1.2"/>
                        <Path Data="M10.5,8.5 C12,8.5 12.5,10 12.5,11.5" Stroke="White" StrokeThickness="1.3"/>
                    <Path Data="M11.2,10 L12.6,11.6 L13.4,9.8 Z" Fill="White"/>
                    <Path Data="M13.5,15.5 C12,15.5 11.5,14 11.5,12.5" Stroke="White" StrokeThickness="1.3"/>
                        <Path Data="M12.8,14 L11.4,12.4 L10.6,14.2 Z" Fill="White"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button Background="#FFA500"
                Margin="0,0,10,0" Name="Button_Minimize" Content="─" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30" Click="Button_Minimize_Click" Cursor="Hand" FontWeight="Bold" FontSize="20">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Width="30"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CC8400"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#996300"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Margin="0,0,10,0" Name="Button_Close" Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30" Click="Button_Close_Click" Cursor="Hand" Background="#FE6584">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Width="50"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF4C70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="DarkRed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <Popup x:Name="LayoutHintPopup"
               PlacementTarget="{Binding ElementName=LayoutToggleButton}"
               Placement="Bottom"
               HorizontalOffset="-40" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1F2937" CornerRadius="8" Padding="14,10"
                    BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="LayoutHintTitle" Foreground="White"
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LayoutHintBody" Foreground="#D1D5DB" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="240"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <Grid x:Name="SplitLayoutGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#E0E0E0"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWE">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#E0E0E0">
                                <Rectangle Width="2" HorizontalAlignment="Center"
                                           Fill="#A0A0A0" RadiusX="1" RadiusY="1"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <ScrollViewer x:Name="SubtitleScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SubtitleSectionPanel" Margin="0">
                        <GroupBox x:Name="TranscriptGroupBox" Header="Transcript">
                            <StackPanel>
                            
                            <TextBlock x:Name="UrlLabel" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Video URL or ID</TextBlock>
                            <TextBox Name="UrlTextBox"/>
                            <TextBlock x:Name="SubtitleLangLabel" Margin="0,15,0,0" FontWeight="SemiBold">Subtitle Language</TextBlock>
                            <ComboBox x:Name="LanguageCodeComboBox" SelectedIndex="0" Margin="0,10,0,0">
                                <ComboBoxItem x:Name="LangCodeEn" Content="English (en)" Tag="en"/>
                                <ComboBoxItem x:Name="LangCodeZh" Content="Chinese (zh)" Tag="zh"/>
                                <ComboBoxItem x:Name="LangCodeJa" Content="Japanese (ja)" Tag="ja"/>
                                <ComboBoxItem x:Name="LangCodeKo" Content="Korean (ko)" Tag="ko"/>
                                <ComboBoxItem x:Name="LangCodeEs" Content="Spanish (es)" Tag="es"/>
                                <ComboBoxItem x:Name="LangCodeFr" Content="French (fr)" Tag="fr"/>
                                <ComboBoxItem x:Name="LangCodeRu" Content="Russian (ru)" Tag="ru"/>
                            </ComboBox>

                            <Button Background="SkyBlue" x:Name="ExtractButton" Margin="0,10,0,10" Click="ExtractButton_Click" HorizontalAlignment="Center">
                                Extract Transcript
                            </Button>

                            <TextBlock x:Name="TranscriptLabel" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Transcript</TextBlock>
                            <TextBox x:Name="TranscriptTextBox" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <Button x:Name="ShowMoreButton" Content="▼" Visibility="Collapsed" Margin="0,5,0,0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16" Click="ShowMoreButton_Click"/>

                            <TextBlock x:Name="ExportFormatLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Export Format</TextBlock>
                            <ComboBox x:Name="ExportFormatComboBox" Margin="0,0,0,0"/>
                            <Button x:Name="ExportButton" Background="#4ECDC4" Margin="0,5,0,0" HorizontalAlignment="Center" Click="ExportButton_Click">
                                Export
                            </Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AiScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AiSectionPanel" Margin="0">
                        <GroupBox x:Name="SummarizationGroupBox" Header="Summarization" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="BaseUrlLabel" Margin="0,0,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI Base URL (API Endpoint)</TextBlock>
                                
                                <TextBox Name="BaseUrlTextBox" TextChanged="BaseUrlTextBox_TextChanged"/>
                                <TextBlock x:Name="BaseUrlPlaceholder" Text="e.g. https://api.openai.com/v1" Foreground="Gray" IsHitTestVisible="False" Margin="5,0,0,0" VerticalAlignment="Center"/>

                                <TextBlock x:Name="ModelNameLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Model Name</TextBlock>
                                <TextBox Name="ModelTextBox"/>

                                <TextBlock x:Name="ApiKeyLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI API key</TextBlock>
                                <PasswordBox Name="ApiKeyTextBox" PasswordChar="*"/>

                                <Button x:Name="SaveButton" Margin="0,10,0,0" HorizontalAlignment="Center" Click="SaveButton_Click">Save AI Base URL and Model Name</Button>

                                <TextBlock x:Name="ModeLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Mode</TextBlock>
                                <ComboBox x:Name="ModeComboBox" SelectionChanged="ModeComboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="ModeItemSummary" Content="AI Summary" Tag="summary"/>
                                    <ComboBoxItem x:Name="ModeItemTranslation" Content="AI Translation" Tag="translation"/>
                                    <ComboBoxItem x:Name="ModeItemKnowledge" Content="AI Knowledge Graph" Tag="knowledge"/>
                                </ComboBox>

                                <StackPanel x:Name="SummaryPanel">
                                    <TextBlock x:Name="SummaryTargetLangLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Target Summary Language</TextBlock>
                                    <ComboBox x:Name="SummaryTargetLangComboBox" SelectionChanged="SummaryTargetLangComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English (en)" Tag="en"/>
                                        <ComboBoxItem Content="中文 (zh)" Tag="zh"/>
                                        <ComboBoxItem Content="日本語 (ja)" Tag="ja"/>
                                        <ComboBoxItem Content="한국어 (ko)" Tag="ko"/>
                                        <ComboBoxItem Content="Español (es)" Tag="es"/>
                                        <ComboBoxItem Content="Français (fr)" Tag="fr"/>
                                        <ComboBoxItem Content="Deutsch (de)" Tag="de"/>
                                        <ComboBoxItem Content="Русский (ru)" Tag="ru"/>
                                        <ComboBoxItem Content="Português (pt)" Tag="pt"/>
                                        <ComboBoxItem Content="Italiano (it)" Tag="it"/>
                                        <ComboBoxItem x:Name="SummaryTargetCustom" Content="Custom" Tag="custom"/>
                                    </ComboBox>
                                    <TextBox x:Name="SummaryCustomLangTextBox" Margin="0,5,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SummaryLengthLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Summary Length</TextBlock>
                                    <ComboBox x:Name="SummaryLengthComboBox" SelectionChanged="SummaryLengthComboBox_SelectionChanged"/>
                                    <TextBox x:Name="CustomLengthTextBox" Margin="0,5,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel x:Name="TranslationPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="TranslationTargetLangLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Target Translation Language</TextBlock>
                                    <ComboBox x:Name="TranslationTargetLangComboBox" SelectionChanged="TranslationTargetLangComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English (en)" Tag="en"/>
                                        <ComboBoxItem Content="中文 (zh)" Tag="zh"/>
                                        <ComboBoxItem Content="日本語 (ja)" Tag="ja"/>
                                        <ComboBoxItem Content="한국어 (ko)" Tag="ko"/>
                                        <ComboBoxItem Content="Español (es)" Tag="es"/>
                                        <ComboBoxItem Content="Français (fr)" Tag="fr"/>
                                        <ComboBoxItem Content="Deutsch (de)" Tag="de"/>
                                        <ComboBoxItem Content="Русский (ru)" Tag="ru"/>
                                        <ComboBoxItem Content="Português (pt)" Tag="pt"/>
                                        <ComboBoxItem Content="Italiano (it)" Tag="it"/>
                                        <ComboBoxItem x:Name="TranslationTargetCustom" Content="Custom" Tag="custom"/>
                                    </ComboBox>
                                    <TextBox x:Name="TranslationCustomLangTextBox" Margin="0,5,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel x:Name="KnowledgeGraphPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="KnowledgeTargetLangLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Target Language</TextBlock>
                                    <ComboBox x:Name="KnowledgeTargetLangComboBox" SelectionChanged="KnowledgeTargetLangComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English (en)" Tag="en"/>
                                        <ComboBoxItem Content="中文 (zh)" Tag="zh"/>
                                        <ComboBoxItem Content="日本語 (ja)" Tag="ja"/>
                                        <ComboBoxItem Content="한국어 (ko)" Tag="ko"/>
                                        <ComboBoxItem Content="Español (es)" Tag="es"/>
                                        <ComboBoxItem Content="Français (fr)" Tag="fr"/>
                                        <ComboBoxItem Content="Deutsch (de)" Tag="de"/>
                                        <ComboBoxItem Content="Русский (ru)" Tag="ru"/>
                                        <ComboBoxItem Content="Português (pt)" Tag="pt"/>
                                        <ComboBoxItem Content="Italiano (it)" Tag="it"/>
                                        <ComboBoxItem x:Name="KnowledgeTargetCustom" Content="Custom" Tag="custom"/>
                                    </ComboBox>
                                    <TextBox x:Name="KnowledgeCustomLangTextBox" Margin="0,5,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="KnowledgePreviewLabel" Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Preview</TextBlock>
                                    <Border BorderBrush="Gray" BorderThickness="1" Height="300" Margin="0,0,0,5">
                                        <WebBrowser x:Name="MermaidBrowser"/>
                                    </Border>
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Button x:Name="ExportSvgButton" Content="Export SVG" Margin="0,0,5,0" Click="ExportSvgButton_Click"/>
                                        <Button x:Name="ExportPngButton" Content="Export PNG" Click="ExportPngButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Button Background="Violet" x:Name="SummarizeButton" Margin="0,10,0,20" Click="SummarizeButton_Click" IsEnabled="False" HorizontalAlignment="Center"/>

                                <TextBlock x:Name="SummaryLabel" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Result</TextBlock>
                                <TextBox x:Name="SummaryTextBox" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <Button x:Name="SummaryShowMoreButton" Visibility="Collapsed" Margin="0,5,0,0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16" Click="SummaryShowMoreButton_Click"/>
                                <Button x:Name="ExportResultButton" Margin="0,5,0,0" HorizontalAlignment="Center" Click="ExportResultButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="ScrollLayoutViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ScrollLayout_PreviewMouseWheel"
                          Visibility="Collapsed">
                <StackPanel x:Name="ScrollLayoutHost">
                    <Border x:Name="ScrollSectionSubtitle"
                            MinHeight="{Binding ActualHeight, ElementName=ScrollLayoutViewer}"
                            Padding="24">
                    </Border>
                    <Border x:Name="ScrollSectionAi"
                            MinHeight="{Binding ActualHeight, ElementName=ScrollLayoutViewer}"
                            Padding="24">
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>

</Window>
