<Window x:Class="SimpVid_Gist_WPF.LanguagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Language / 选择语言"
        Width="350" Height="180"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Please select your language / 请选择语言"
                   TextAlignment="Center" FontSize="16" Margin="0,0,0,20"/>
        <Button Content="English" Height="36" Margin="0,0,0,8" FontSize="14" Click="EnglishButton_Click"/>
        <Button Content="中文" Height="36" FontSize="14" Click="ChineseButton_Click"/>
    </StackPanel>
</Window>
